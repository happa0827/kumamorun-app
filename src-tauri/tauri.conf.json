{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kumamorun",
  "version": "2.5.1",
  "identifier": "com.kumamorun.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kumamorun",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kumamorun"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2QkQ3M0UxOTBFNjI3NEEKUldSS0orYVE0WE85MWpCUEgrZjhNRkN5aExjVSsxR0pIUjdybkIwNENKK2VqMVhBakIvelY4STYK",
      "endpoints": [
        "https://github.com/happa0827/kumamorun-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": "9386191B5CD3D603E267FC3D28A8CC9C558D7B49",
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"]
      }
    }
  }
}
